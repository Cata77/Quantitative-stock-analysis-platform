# Explicit local-development defaults. Copy to infrastructure/.env and change values as needed.
TIMESCALEDB_DB=quant_platform
TIMESCALEDB_USER=postgres
TIMESCALEDB_PASSWORD=postgres_secure_pass

# Host-facing application ports. Container-to-container ports remain 8080-8085.
GATEWAY_HOST_PORT=18080
AUTH_HOST_PORT=18081
SCREENER_HOST_PORT=18082
PORTFOLIO_HOST_PORT=18083
MARKET_DATA_HOST_PORT=18084
SCORING_HOST_PORT=18085

# Optional one-file dated universe import. Files under infrastructure/reference-data are mounted
# at /reference-data in the market-data-producer container.
REFERENCE_DATA_IMPORT_ENABLED=false
REFERENCE_DATA_IMPORT_FILE=/reference-data/snapshot-template.csv
REFERENCE_DATA_IMPORT_UNIVERSE=SP500
REFERENCE_DATA_IMPORT_EFFECTIVE_DATE=2026-08-23
REFERENCE_DATA_IMPORT_AVAILABLE_AT=2026-08-23T00:00:00Z
REFERENCE_DATA_IMPORT_OBSERVED_AT=2026-08-23T00:00:00Z
REFERENCE_DATA_IMPORT_SOURCE=MANUALLY_SUPPLIED_DATED_SNAPSHOT
REFERENCE_DATA_IMPORT_SOURCE_URI=
REFERENCE_DATA_IMPORT_MODE=CURRENT_SNAPSHOT_FORWARD
REFERENCE_DATA_IMPORT_COMPLETENESS=COMPLETE
REFERENCE_DATA_IMPORT_EXPECTED_MEMBER_COUNT=0
REFERENCE_DATA_CLASSIFICATION_SOURCE=
REFERENCE_DATA_CLASSIFICATION_VERSION=

# Phase 4 operational daily data. Keep credentials in your ignored .env.
MARKET_DATA_ENABLED=false
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
DAILY_PRICE_FEED=sip
DAILY_PRICE_SYMBOLS_PER_REQUEST=100
DAILY_PRICE_REQUEST_SPACING=350ms
DAILY_PRICE_PUBLICATION_DELAY=16m
DAILY_PRICE_ADJUSTED_ENABLED=true
DAILY_PRICE_CORPORATE_ACTIONS_ENABLED=true
DAILY_PRICE_ACTIONS_REFRESH_DAYS=14
INGESTION_MODE=catch-up-and-serve
INGESTION_SCHEDULES_ENABLED=true
INGESTION_ITEMS_PER_CYCLE=100
