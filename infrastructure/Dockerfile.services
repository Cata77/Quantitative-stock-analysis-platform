FROM gradle:9.1.0-jdk25 AS builder

WORKDIR /workspace
COPY settings.gradle build.gradle ./
COPY security-common ./security-common
COPY observability-common ./observability-common
COPY ingestion-contract ./ingestion-contract
COPY web-backend ./web-backend
COPY market-data-producer ./market-data-producer
COPY database-migrations/build.gradle ./database-migrations/build.gradle

RUN gradle \
    :web-backend:bootJar \
    :market-data-producer:bootJar \
    --no-daemon

FROM eclipse-temurin:25.0.2_10-jre AS web-backend
WORKDIR /app
COPY --from=builder /workspace/web-backend/build/libs/web-backend-*.jar ./app.jar
ENTRYPOINT ["java", "-jar", "/app/app.jar"]

FROM eclipse-temurin:25.0.2_10-jre AS market-data-producer
WORKDIR /app
COPY --from=builder /workspace/market-data-producer/build/libs/market-data-producer-*.jar ./app.jar
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
