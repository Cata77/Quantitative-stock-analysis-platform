{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen stock-scoring 1.0.0 allow-listed contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_code",
    "version",
    "profile_version",
    "input_version",
    "status",
    "schedule",
    "profiles",
    "weights",
    "preprocessing",
    "eligibility",
    "risk",
    "tax",
    "arithmetic",
    "periods",
    "research",
    "formula_contract",
    "input_contract"
  ],
  "properties": {
    "model_code": {
      "const": "stock-value-quality-momentum"
    },
    "version": {
      "const": "1.0.0"
    },
    "profile_version": {
      "const": "profiles-v1"
    },
    "input_version": {
      "const": "prepared-canonical-v1"
    },
    "status": {
      "const": "FROZEN_RESEARCH_HYPOTHESIS"
    },
    "schedule": {
      "const": {
        "signal": "LAST_REGULAR_SESSION_CLOSE_OF_MONTH",
        "execution": "NEXT_REGULAR_SESSION_OPEN",
        "holding": "UNTIL_NEXT_MONTHLY_REBALANCE",
        "universe": "POINT_IN_TIME_SP500_NASDAQ100_UNION",
        "baseline_cost_bps_per_side": 10
      }
    },
    "profiles": {
      "const": {
        "GENERAL": {
          "value": [
            "ebit_ev",
            "fcf_yield",
            "book_market"
          ],
          "quality": [
            "gross_profitability",
            "roic",
            "cash_earnings"
          ],
          "anchor": null
        },
        "BANK": {
          "value": [
            "earnings_yield",
            "tangible_book",
            "net_payout"
          ],
          "quality": [
            "roa",
            "cet1",
            "credit_quality"
          ],
          "anchor": "cet1"
        },
        "PC_INSURER": {
          "value": [
            "earnings_yield",
            "tangible_book",
            "net_payout"
          ],
          "quality": [
            "operating_roe",
            "underwriting_margin",
            "earnings_stability"
          ],
          "anchor": "rbc"
        },
        "LIFE_INSURER": {
          "value": [
            "earnings_yield",
            "tangible_book",
            "net_payout"
          ],
          "quality": [
            "operating_roe",
            "operating_roa",
            "earnings_stability"
          ],
          "anchor": "rbc"
        },
        "EQUITY_REIT": {
          "value": [
            "ffo_yield",
            "affo_yield",
            "ebitdare_yield"
          ],
          "quality": [
            "noi_growth",
            "interest_coverage",
            "leverage_quality"
          ],
          "anchor": "ffo"
        }
      }
    },
    "weights": {
      "const": {
        "primary": [
          0.5,
          0.3,
          0.2
        ],
        "pure_value": [
          1,
          0,
          0
        ],
        "value_quality": [
          0.6,
          0.4,
          0
        ],
        "balanced": [
          0.4,
          0.4,
          0.2
        ]
      }
    },
    "preprocessing": {
      "const": {
        "primary_minimum": 10,
        "fallback_minimum": 20,
        "fallback": "SAME_PROFILE_ONLY",
        "percentiles": [
          0.025,
          0.975
        ],
        "percentile_method": "LINEAR_N_MINUS_ONE",
        "ddof": 0,
        "dispersion_epsilon": 1e-12,
        "z_clip": 3,
        "minimum_family_metrics": 2,
        "family_denominator": 3,
        "cohort": "UNIVERSAL_AND_RAW_COVERAGE_ELIGIBLE_ONCE",
        "momentum_cohort": "SAME_PROFILE",
        "missing": "NULL_WITH_REASON_THEN_ZERO_ONLY_AFTER_FAMILY_COVERAGE"
      }
    },
    "eligibility": {
      "const": {
        "minimum_adjusted_price": 5,
        "minimum_median_dollar_volume": 5000000,
        "liquidity_sessions": 20,
        "history_sessions": 252,
        "maximum_filing_age_days": 180
      }
    },
    "risk": {
      "const": {
        "cet1_surplus_exclude": 0,
        "cet1_surplus_warn": 0.01,
        "rbc_exclude": 2,
        "rbc_warn": 3,
        "combined_ratio_warn": 1.05,
        "reit_coverage_exclude": 1.5,
        "reit_coverage_warn": 2,
        "reit_leverage_exclude": 10,
        "reit_leverage_warn": 8,
        "reit_payout_exclude": 1.2,
        "reit_payout_warn": 1,
        "earnings_stability_quarters": 12
      }
    },
    "tax": {
      "const": {
        "annual_years": 3,
        "clip": [
          0,
          0.4
        ],
        "fallbacks": [
          {
            "jurisdiction": "US",
            "effective_from": "2018-01-01",
            "effective_to": "2027-01-01",
            "rate": 0.21,
            "version": "us-federal-corporate-2018-v1",
            "source": "https://www.irs.gov/irm/part21/irm_21-007-004r"
          }
        ]
      }
    },
    "arithmetic": {
      "const": {
        "precision": "IEEE754_BINARY64",
        "rounding": "ONLY_SERIALIZED_RESULTS_HALF_EVEN",
        "storage_decimals": 6,
        "parity_absolute_tolerance": 1e-09,
        "ties": "EXACT_UNROUNDED_COMPOSITE_AVERAGE_RANK",
        "ordinal_tie_break": "INSTRUMENT_UUID",
        "minimum_eligible": 2
      }
    },
    "periods": {
      "const": {
        "annual_days": [
          350,
          380
        ],
        "quarter_days": [
          70,
          110
        ],
        "comparable_tolerance_days": 7,
        "ttm": "DIRECT_ANNUAL_THEN_FOUR_CONTIGUOUS_QUARTERS_THEN_ANNUAL_PLUS_YTD_MINUS_PRIOR_YTD",
        "missing_components": "NEVER_ASSUME_ZERO",
        "ebit": "PRETAX_INCOME_PLUS_INTEREST_EXPENSE",
        "debt": "DEBT_CURRENT_PLUS_DEBT_NONCURRENT",
        "shares": "INSTRUMENT_SHARES_OUTSTANDING_NOT_WEIGHTED_AVERAGE",
        "insurer_history": "TWELVE_CONTIGUOUS_QUARTERS_ENDING_AT_CURRENT_PERIOD"
      }
    },
    "research": {
      "const": {
        "historical_acceptance": "NOT_EVALUATED",
        "final_test_opened": false
      }
    },
    "formula_contract": {
      "const": {
        "expression_policy": "DOCUMENTATION_ONLY_NOT_EVALUATED",
        "GENERAL": {
          "ebit_ev": "(PRETAX_INCOME_TTM + INTEREST_EXPENSE_TTM) / EV",
          "fcf_yield": "(OPERATING_CASH_FLOW_TTM - CAPEX_TTM) / MARKET_CAP",
          "book_market": "positive COMMON_EQUITY / MARKET_CAP",
          "gross_profitability": "(REVENUE_TTM - COST_OF_REVENUE_TTM) / AVERAGE_TOTAL_ASSETS",
          "roic": "EBIT_TTM * (1 - NORMALIZED_TAX_RATE) / AVERAGE_INVESTED_CAPITAL",
          "cash_earnings": "(OPERATING_CASH_FLOW_TTM - NET_INCOME_TTM) / AVERAGE_TOTAL_ASSETS"
        },
        "FINANCIAL_VALUE": {
          "earnings_yield": "NET_INCOME_COMMON_TTM / MARKET_CAP",
          "tangible_book": "positive (COMMON_EQUITY - GOODWILL - INTANGIBLES) / MARKET_CAP",
          "net_payout": "(COMMON_DIVIDENDS_TTM + COMMON_REPURCHASES_TTM - STOCK_ISSUANCE_TTM) / MARKET_CAP"
        },
        "BANK": {
          "roa": "NET_INCOME_TTM / AVERAGE_TOTAL_ASSETS",
          "cet1": "CET1_CAPITAL / RISK_WEIGHTED_ASSETS",
          "credit_quality": "-(NONACCRUAL_LOANS + PAST_DUE_90_LOANS) / GROSS_LOANS",
          "capital_gate": "CET1 - sum(reviewed dated capital requirement components)"
        },
        "INSURER": {
          "operating_roe": "OPERATING_INCOME_COMMON_TTM / AVERAGE_TANGIBLE_COMMON_EQUITY",
          "operating_roa": "OPERATING_INCOME_TTM / AVERAGE_TOTAL_ASSETS",
          "underwriting_margin": "1 - (LOSSES_LAE_TTM + UNDERWRITING_EXPENSE_TTM) / NET_PREMIUMS_TTM",
          "earnings_stability": "-population_std(previous 12 contiguous OPERATING_ROA quarters)",
          "rbc": "TOTAL_ADJUSTED_CAPITAL / AUTHORIZED_CONTROL_LEVEL_RBC"
        },
        "EQUITY_REIT": {
          "ffo": "NET_INCOME_COMMON_TTM + REAL_ESTATE_DA_TTM - REAL_ESTATE_GAINS_TTM + REAL_ESTATE_LOSSES_TTM + REAL_ESTATE_IMPAIRMENTS_TTM + signed FFO_JV_NCI_TTM",
          "affo": "FFO - MAINTENANCE_CAPEX_TTM - TENANT_IMPROVEMENTS_TTM - LEASING_COMMISSIONS_TTM - NONCASH_RENT_TTM",
          "ebitdare": "NET_INCOME_TTM + INTEREST_EXPENSE_TTM + TAX_EXPENSE_TTM + DA_TTM - PROPERTY_GAINS_TTM + PROPERTY_LOSSES_TTM + REAL_ESTATE_IMPAIRMENTS_TTM + signed EBITDARE_AFFILIATES_TTM",
          "ffo_yield": "FFO / MARKET_CAP",
          "affo_yield": "AFFO / MARKET_CAP",
          "ebitdare_yield": "EBITDARE / EV",
          "noi_growth": "SAME_STORE_NOI_TTM / SAME_STORE_NOI_PRIOR_TTM - 1",
          "interest_coverage": "EBITDARE / CASH_INTEREST_TTM",
          "leverage_quality": "-(DEBT_CURRENT + DEBT_NONCURRENT - CASH) / EBITDARE",
          "affo_payout": "DIVIDENDS_DECLARED_TTM / AFFO",
          "prior_payout": "DIVIDENDS_DECLARED_PRIOR_TTM / AFFO_PRIOR_TTM; previous quarter's reconciled TTM",
          "occupancy": "OCCUPIED_AREA / AVAILABLE_AREA"
        },
        "SHARED": {
          "market_cap": "RAW_CLOSE * instrument SHARES_OUTSTANDING",
          "ev": "MARKET_CAP + DEBT_CURRENT + DEBT_NONCURRENT + PREFERRED_EQUITY + MINORITY_INTEREST - CASH",
          "invested": "COMMON_EQUITY + PREFERRED_EQUITY + DEBT_CURRENT + DEBT_NONCURRENT + MINORITY_INTEREST - CASH",
          "averages": "(current + prior comparable year balance) / 2",
          "momentum": "MOMENTUM_RECENT[t-21] / MOMENTUM_OLD[t-252] - 1",
          "tax": "median of 3 valid aligned annual tax/positive-pretax ratios, clipped [0,.4]; otherwise dated jurisdiction fallback"
        }
      }
    },
    "input_contract": {
      "const": {
        "required_metadata": [
          "instrument_id",
          "profile",
          "profile_supported",
          "peer_group",
          "period_end",
          "filing_date",
          "in_universe",
          "active",
          "primary_class",
          "security_type",
          "history_count",
          "liquidity_count",
          "values",
          "provenance"
        ],
        "scalar_evidence": [
          "source_ids",
          "unit",
          "period_end",
          "available_at",
          "observed_at"
        ],
        "missing_components": "NOT_REPORTED; no inferred zero balances or supplemental adjustments",
        "profile_support": "Explicit reviewed parent-level scope; Phase 6 adapter only enables GENERAL",
        "units": {
          "money": "USD",
          "shares": "shares",
          "ratios": "pure",
          "area": "square_feet"
        },
        "invalid_denominator": "Missing unless strictly positive; negative earnings and cash flow retained",
        "storage": "six decimal places, half even, rank before rounding",
        "annual_tax_minimum_valid_years": 3,
        "regulatory_scope": "PUBLIC_PARENT with explicit STANDARDIZED or ADVANCED capital approach",
        "capital_requirement_dates": "Each component requires effective_from <= score date < effective_to, plus available/observed cutoffs",
        "period_alignment": "Current balances and TTM share current period_end; prior balances are 350-380 days earlier; prior REIT payout components share previous quarter end",
        "price_availability": "Phase 6 adapter records a conservative cutoff upper bound and retains observation keys"
      }
    }
  }
}
